# Salin menjadi .env lalu ganti nilainya sebelum dipakai di server produksi
POSTGRES_PASSWORD=ganti-password-db
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
APP_PORT=8080
# Password akun admin pertama (dibuat otomatis bila belum ada pengguna). Kosongkan = acak, lihat di log.
ADMIN_PASSWORD=
# Domain untuk HTTPS otomatis (profil https)
DOMAIN=bku.contoh.go.id
